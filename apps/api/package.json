{
  "name": "@devpractice/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts && vitest run --config tests/learning/vitest.config.ts",
    "seed": "tsx src/scripts/seed.ts",
    "owner:bootstrap": "tsx src/scripts/bootstrap-owner.ts",
    "owner:reset-password": "tsx src/scripts/reset-password.ts",
    "maintenance:prune": "tsx src/scripts/prune.ts"
  },
  "dependencies": {
    "@devpractice/contracts": "workspace:*",
    "@devpractice/learning-core": "workspace:*",
    "@prisma/client": "5.22.0",
    "@node-rs/argon2": "1.8.3",
    "fastify": "4.28.1",
    "@fastify/cookie": "9.4.0",
    "@fastify/static": "7.0.4",
    "@fastify/multipart": "8.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "tsx": "4.19.2",
    "vitest": "2.1.8",
    "prisma": "5.22.0",
    "@types/node": "22.9.0"
  }
}
