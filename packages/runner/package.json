{
  "name": "@devpractice/runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./node": "./src/node-runner.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
