  },
  "dependencies": {
    "@devpractice/contracts": "workspace:*",
    "quickjs-emscripten": "0.31.0",
    "quickjs-emscripten-core": "0.31.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.31.0",
    "typescript": "5.6.3"
  },
  "devDependencies": {
    "vitest": "2.1.8",
    "@types/node": "22.9.0"
  }
}
