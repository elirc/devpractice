{
  "name": "@devpractice/content-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": { "dp-content": "./src/cli.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx src/cli.ts validate",
    "build:package": "tsx src/cli.ts build",
    "build": "echo \"content-tools: source-only package\""
  },
  "dependencies": {
    "@devpractice/contracts": "workspace:*",
    "@devpractice/runner": "workspace:*",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "tsx": "4.19.2",
    "vitest": "2.1.8",
    "@types/node": "22.9.0"
  }
}
