{
  "name": "devpractice",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:seed": "pnpm --filter @devpractice/api seed",
    "content:validate": "pnpm --filter @devpractice/content-tools validate",
    "content:build": "pnpm --filter @devpractice/content-tools build:package",
    "owner:bootstrap": "pnpm --filter @devpractice/api owner:bootstrap",
    "owner:reset-password": "pnpm --filter @devpractice/api owner:reset-password"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "@types/node": "22.9.0",
    "@prisma/client": "5.22.0"
  }
}
